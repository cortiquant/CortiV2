# =============================================================================
# CortiQuant Backend — Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `backend/.env`:
#      cp backend/.env.example backend/.env
# 2. Fill in the values for your environment.
# 3. NEVER commit the `.env` file to git or expose it in client-side code.
# =============================================================================

# Server Port (default: 3001)
PORT=3001

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/cortiquant?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key (required)
# Generate a cryptographically secure 64-byte key using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# JWT Token Expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated list of frontend URLs)
# Example: https://cortiquant.online,http://localhost:8443
CORS_ORIGIN=http://localhost:8443

# Frontend Application URL (used for invitation links and redirects)
FRONTEND_URL=http://localhost:8443
APP_URL=http://localhost:8443

# Email Service — SMTP Configuration (e.g. Gmail SMTP or AWS SES)
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CortiQuant <noreply@cortiquant.online>

# AI Engine Configuration (Google Gemini / OpenAI compatible)
# Provide your Gemini API key:
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# Initial Admin / Founder Credentials (used for root bootstrap and seedAdmin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Founder Admin
